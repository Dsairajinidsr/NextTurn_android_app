<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8ECF0"
    tools:context=".SplashPage">

    <!-- Top Right Arc -->
    <View
        android:id="@+id/topRightArc"
        android:layout_width="150dp"
        android:layout_height="170dp"
        android:background="@drawable/top_right_semicircle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:layout_marginTop="100dp"
        android:src="@drawable/appicon"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_marginLeft="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Horizontal Line -->
    <View
        android:id="@+id/horizontalLine"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="70dp"
        android:background="#009688"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Choose Your Role -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Choose Your Role"
        android:textColor="#0C3661"
        android:textStyle="bold"
        android:textSize="25sp"
        app:layout_constraintTop_toBottomOf="@id/horizontalLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Grid Layout -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Patient -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="10dp"
            >

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/patienticon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient"
                android:textColor="#0C3661"
                android:textStyle="bold"
                android:layout_marginLeft="15dp"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>
            <!--patient description-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book your queue,heck status and get notified"
                android:textColor="#0C3661"
                android:textAlignment="center"
                android:textStyle="italic"
                android:textSize="13sp"
                android:layout_marginTop="5dp"
                />
            <!--button to go patient login page-->
            <Button
                android:id="@+id/btnpatient"
                android:layout_width="100dp"
                android:layout_height="42dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#18B7A9"
                app:cornerRadius="20dp"
                android:textSize="14dp"
                android:layout_marginTop="25dp"/>


        </LinearLayout>

        <!--Staff -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="10dp"
            >

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/stafficon"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff"
                android:textStyle="bold"
                android:textColor="#0C3661"
                android:textSize="20sp"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="25dp"/>
            <!--staff Description-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="manage queues,assist patients and update status"
                android:textColor="#0C3661"
                android:textStyle="italic"
                android:textSize="13sp"
                android:textAlignment="center"
                android:layout_marginTop="5dp"
                />
            <!--button to go staff login page-->
            <Button
                android:id="@+id/btnstaff"
                android:layout_width="100dp"
                android:layout_height="42dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#18B7A9"
                app:cornerRadius="20dp"
                android:textSize="14dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

        <!--Manager-->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="10dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/managericon"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manager"
                android:textColor="#0C3661"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="10dp"/>
            <!--Manager description-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage staff,monitor operations and view reports"
                android:textColor="#0C3661"
                android:textStyle="italic"
                android:textSize="13sp"
                android:textAlignment="center"
                android:layout_marginTop="5dp"
                />
            <!--button to go manager login page-->
            <Button
                android:id="@+id/btnmanager"
                android:layout_width="100dp"
                android:layout_height="42dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#18B7A9"
                app:cornerRadius="20dp"
                android:textSize="14dp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </GridLayout>
    <!--Bottom left arc-->
    <View
        android:id="@+id/bottomLeftArc"
        android:layout_width="140dp"
        android:layout_height="150dp"
        android:background="@drawable/bottom_left_semicircle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <!--Bottom Right arc-->
    <View
        android:id="@+id/bottomRightArc"
        android:layout_width="140dp"
        android:layout_height="150dp"
        android:background="@drawable/bottom_right_semicircle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>