<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" /> <!-- Camera Permission -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextTurn_Project">

        <activity
            android:name=".manager.ManagerReportsActivity"
            android:exported="false" />

        <service
            android:name=".patient.notifications.MyFirebaseMessagingService"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".auth.patient.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".staff.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ChooseUsers_page"
            android:exported="false" />
        <activity
            android:name=".staff.StaffDashBoardActivity"
            android:exported="false" />
        <activity
            android:name=".patient.PatientDashboardActivity"
            android:exported="false"
            tools:ignore="DuplicateActivity" />
        <activity
            android:name=".manager.ManagerDashBoardActivity"
            android:exported="false" />
        <activity
            android:name=".auth.staff.StaffRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".auth.staff.StaffLoginActivity"
            android:exported="false" />
        <activity
            android:name=".auth.patient.PatientRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".auth.patient.PatientLoginActivity"
            android:exported="false" />
        <activity
            android:name=".auth.manager.ManagerRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".auth.manager.ManagerLoginActivity"
            android:exported="false" />
        <!--
 <activity
            android:name=".LoginPage"
            android:exported="false" />
        -->
        <activity
            android:name=".SplashPage"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>